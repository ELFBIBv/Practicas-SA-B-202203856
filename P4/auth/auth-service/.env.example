# Puerto donde corre el servidor de Auth (por defecto 4000 en docker-compose)
PORT=4000

# Base de datos PostgreSQL
DB_USER=postgres
DB_HOST=localhost
DB_NAME=auth_db
DB_PASSWORD=postgres
DB_PORT=5432

# Configuraciones de Seguridad (JWT)
JWT_SECRET=supersecret123
JWT_EXPIRES_IN=1h
JWT_GRACE_PERIOD_SEC=300

# Encriptación
# Poner en 'true' si se quiere guardar la password con AES en lugar de bcrypt
USE_AES_FOR_PASSWORD=false
AES_SECRET=my_aes_secret_key_1234567890123
